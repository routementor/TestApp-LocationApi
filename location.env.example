# Variables for the location-api*.hurl suites (hurl --variables-file).
# Copy to location.env (git-ignored) and fill in the real values:
#   cp location.env.example location.env
# now_epoch / since_epoch / today are computed by run.sh.

# Location server, including index.php
base_url=http://rmlsrv01.routementor.com/restapi/index.php

# X-API-KEY: a private_key from rm_location.rm_restapi_access
# (the driver app uses Api.x_api_key_loc_server)
api_key=<your-api-key>

# Set these to a real (ideally test) company / trip / employee / driver
#Test  testadmin@routementor.com company_id=5, driver_id=17216
company_id=5
trip_id=20261025
user_id=10325
driver_id=17216

# FMS web app login, used only by basic.hurl
fms_email=<fms-login-email>
fms_password=<fms-login-password>

# run.sh setting (passed to hurl as --error-format, not used by the .hurl files)
#   long  = print the full HTTP response (status, headers, body) for failing requests
#   short = one-line assert errors only
error_format=long
